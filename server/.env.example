# PrepDeck Environment Configuration Template
# Copy this file to .env and configure for your environment

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection URI (e.g. mongodb://localhost:27017/prepdeck or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/prepdeck

# Secret key used for signing JWT tokens (use a strong, random 32+ character string in production)
JWT_SECRET=your_jwt_secret_key_min_32_characters

# Google Gemini API Key for AI interview questions, follow-ups, and quizzes
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated for multiple domains, or * for development)
# Example: https://prepdeck.onrender.com,http://localhost:5000
CORS_ORIGIN=*

# Path to private document storage (defaults to server/uploads)
# On persistent volumes (e.g. Render Disk), set to mounted directory path
STORAGE_PATH=./uploads
